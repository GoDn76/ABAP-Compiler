[Unit]
Description=ABAPC Studio 5.0.1 Rust Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/abapc
ExecStart=/opt/abapc/abapc-server
Restart=always
RestartSec=5
LimitNOFILE=65535
EnvironmentFile=/opt/abapc/.env
Environment=RUST_LOG=info
Environment=ABAPC_HOST=0.0.0.0
Environment=ABAPC_PORT=7345
Environment=ABAPC_NO_BROWSER=1

# Memory protection for 2GB VPS
MemoryMax=512M

[Install]
WantedBy=multi-user.target
