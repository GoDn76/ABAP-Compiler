# ABAPC Studio 5.0.1 Environment Variables
ABAPC_PORT=7345
ABAPC_HOST=127.0.0.1
ABAPC_NO_BROWSER=1
RUST_LOG=info

# Optional Postgres database (Supabase, Neon, or local Docker)
DATABASE_URL=postgres://abap:abap_secret@localhost:5432/abapc_studio

# Optional Redis session store (for RAP session buffers)
REDIS_URL=redis://localhost:6379/0
