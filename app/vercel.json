{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/sapgui",
      "dest": "/gui.html"
    },
    {
      "src": "/transactions",
      "dest": "/gui.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
